# Copy this file to .env and fill in your values

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Strava API — create app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=pick_any_random_string_here

# Garmin Connect credentials
GARMIN_EMAIL=
GARMIN_PASSWORD=

# VAPID keys for Web Push — generated by: python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:you@example.com

# Set to your public URL when deploying (e.g. https://yourapp.fly.dev)
PUBLIC_URL=
